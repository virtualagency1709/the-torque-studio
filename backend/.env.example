# The Torque Studio — Environment Configuration Example
APP_ENV=production
APP_URL=https://your-domain.com
APP_SECRET=Generate_A_Random_Secure_Secret_Here_At_Least_32_Chars

# MySQL / MariaDB Database (e.g. Hostinger / cPanel / Localhost)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=the_torque_studio
DB_USER=root
DB_PASS=

# SMTP Mail Server (Hostinger Titan Mail, Google Workspace, AWS SES, etc.)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=enquiries@thetorquestudio.in
SMTP_PASS=YourSecureEmailPassword
SMTP_SECURE=tls
MAIL_FROM=enquiries@thetorquestudio.in
NOTIFICATION_EMAIL=info@thetorquestudio.in
